        {
            "id": "RDOC-CALL-SEQ-REDOS",
            "title": "ReDoS in RDoc::Comment#extract_call_seq (call-seq parsing)",
            "language": "ruby",
            "severity": "medium",
            "packages": [
                "ruby",
                "rdoc"
            ],
            "affected": [
                "rdoc < 6.5.0",
                "ruby 3.1.x (bundled rdoc 6.4.1.1)"
            ],
            "references": [
                "https://github.com/ruby/rdoc/commit/1311ca8c50",
                "https://github.com/ruby/rdoc/pull/995",
                "https://github.com/ruby/ruby/commit/c2871161b453b37b444a759ebec6260c2c0fd0a4"
            ],
            "notes": [
                "No CVE was assigned. Fixed upstream in rdoc 6.5.0 by commit 1311ca8c50 ('Fix polynominal backtracking').",
                "The vulnerable inner expression is applied to the captured body of a :call-seq: comment. Many blank lines followed by a non-matching line make Onigmo backtrack exponentially; the outer call-seq expression is a second, separate hazard in the same method.",
                "The scanner records Ruby /m as the flag 's'."
            ],
            "patterns": [
                {
                    "pattern": "(^\\s*\\n)+^(\\s*\\w+)",
                    "flags": "s",
                    "status": "vulnerable",
                    "witness": {
                        "prefix": "",
                        "pump": "\n",
                        "suffix": "",
                        "breaker": "!",
                        "kind": "exponential",
                        "note": "blank lines followed by a non-matching character"
                    }
                }
            ]
        },
        {
            "id": "H1-1485717-IPADDR-REDOS",
            "title": "ReDoS in IPAddr#mask! prefix parsing",
            "language": "ruby",
            "severity": "medium",
            "packages": [
                "ruby",
                "ipaddr"
            ],
            "affected": [
                "ruby 3.1.x and earlier (bundled ipaddr gem)",
                "ipaddr gem <= 1.2.4"
            ],
            "references": [
                "https://hackerone.com/reports/1485717",
                "https://github.com/ruby/ipaddr/blob/v1.2.4/lib/ipaddr.rb#L525"
            ],
            "notes": [
                "No CVE was assigned. The report was closed as resolved by the Ruby 3.2 regexp memoisation optimisation, so Ruby 3.1.x remains affected.",
                "IPAddr.new(\"0.0.0.0/\" + \"1\" * N + \".\") grows quadratically. The call is reachable from Rails ActionDispatch::RemoteIp through X-Forwarded-For.",
                "The regexp itself was not changed upstream."
            ],
            "patterns": [
                {
                    "pattern": "\\A(0|[1-9]+\\d*)\\z",
                    "flags": "",
                    "status": "vulnerable",
                    "witness": {
                        "prefix": "",
                        "pump": "1",
                        "suffix": ".",
                        "breaker": "",
                        "kind": "polynomial",
                        "note": "prefix-length digits followed by a non-digit"
                    }
                }
            ],
            "match_core": false
        }
