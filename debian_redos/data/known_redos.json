        {
            "id": "CVE-2023-28756",
            "cve": "CVE-2023-28756",
            "title": "ReDoS in Ruby Time.rfc2822 date parsing",
            "language": "ruby",
            "severity": "high",
            "packages": [
                "ruby",
                "ruby-time",
                "time"
            ],
            "affected": [
                "ruby < 3.1.4 (bundled time gem)",
                "time gem < 0.2.2"
            ],
            "references": [
                "https://www.ruby-lang.org/en/news/2023/03/28/redos-in-time-cve-2023-28756/",
                "https://github.com/ruby/ruby/commit/51034bda4c1d9977e0d49bd6329eed9ed6ca19c9"
            ],
            "notes": [
                "The fix makes the RFC 2822 regexp linear by removing overlapping whitespace quantifiers.",
                "Both patterns are matched with the extended (x) and case-insensitive (i) flags used by lib/time.rb."
            ],
            "patterns": [
                {
                    "pattern": "\\A\\s*\n          (?:(?:Mon|Tue|Wed|Thu|Fri|Sat|Sun)\\s*,\\s*)?\n          (\\d{1,2})\\s+\n          (Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)\\s+\n          (\\d{2,})\\s+\n          (\\d{2})\\s*\n          :\\s*(\\d{2})\\s*\n          (?::\\s*(\\d{2}))?\\s+\n          ([+-]\\d{4}|\n           UT|GMT|EST|EDT|CST|CDT|MST|MDT|PST|PDT|[A-IK-Z])",
                    "flags": "ix",
                    "status": "vulnerable"
                },
                {
                    "pattern": "\\A\\s*\n          (?:(?:Mon|Tue|Wed|Thu|Fri|Sat|Sun)\\s*,\\s*)?\n          (\\d{1,2})\\s+\n          (Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)\\s+\n          (\\d{2,})\\s+\n          (\\d{2})\\s*\n          :\\s*(\\d{2})\n          (?:\\s*:\\s*(\\d\\d))?\\s+\n          ([+-]\\d{4}|\n           UT|GMT|EST|EDT|CST|CDT|MST|MDT|PST|PDT|[A-IK-Z])",
                    "flags": "ix",
                    "status": "fixed",
                    "note": "patched variant from Ruby 3.1.4"
                }
            ]
        },
        {
            "id": "CVE-2023-36617",
            "cve": "CVE-2023-36617",
            "title": "ReDoS in Ruby URI parser (rfc2396/rfc3986), incomplete fix of CVE-2023-28755",
            "language": "ruby",
            "severity": "medium",
            "packages": [
                "ruby",
                "ruby-uri",
                "uri"
            ],
            "affected": [
                "ruby < 3.1.5 (bundled uri)",
                "uri gem < 0.12.2 (also 0.11.2 / 0.10.3)"
            ],
            "references": [
                "https://www.ruby-lang.org/en/news/2023/06/29/redos-in-uri-cve-2023-36617/",
                "https://github.com/ruby/ruby/pull/7996"
            ],
            "notes": [
                "The URI parser mishandles invalid URLs with specific characters; both rfc2396_parser.rb and rfc3986_parser.rb are affected.",
                "This is an incomplete fix of CVE-2023-28755. The extracted PORT expression shows the remaining ambiguity between the leading and trailing whitespace runs.",
                "The fix makes the whitespace/character-class quantifiers possessive (e.g. \\s*+ and [\\x09\\x0a\\x0c\\x0d ]*+)."
            ],
            "patterns": [
                {
                    "pattern": "\\A[\\x09\\x0a\\x0c\\x0d ]*\\d*[\\x09\\x0a\\x0c\\x0d ]*\\z",
                    "flags": "",
                    "status": "vulnerable",
                    "witness": {
                        "prefix": "",
                        "pump": " ",
                        "suffix": "!",
                        "breaker": "",
                        "kind": "polynomial",
                        "note": "spaces followed by a non-digit make the two whitespace runs overlap"
                    }
                },
                {
                    "pattern": "\\A[\\x09\\x0a\\x0c\\x0d ]*+\\d*[\\x09\\x0a\\x0c\\x0d ]*\\z",
                    "flags": "",
                    "status": "fixed",
                    "note": "patched variant with possessive quantifiers (Ruby 3.1.5)"
                }
            ]
        },
